rass"
local n = 0
for entry in string.gmatch(FIELDS, "[^;]+") do
	local x, z, w, d, mat = string.match(entry, "(-?%d+),(-?%d+),(%d+),(%d+),(%a+)")
	if x then
		local m = Enum.Material[mat]
		Terrain:FillBlock(CFrame.new(tonumber(x), -1, tonumber(z)), Vector3.new(tonumber(w), 2.2, tonumber(d)), m)
		n += 1
		if n % 60 == 0 then task.wait() end
	end
end

---------------------------------------------------------------- ПЛЯЖ И МОРЕ (восток)
Terrain:FillBlock(CFrame.new(2960, -4, 0), Vector3.new(320, 8, 12288), Enum.Material.Sand)
Terrain:FillBlock(CFrame.new(3260, -10, 0), Vector3.new(400, 4, 12288), Enum.Material.Sand)
Terrain:FillBlock(CFrame.new(4200, -5, 0), Vector3.new(2400, 14, 12288), Enum.Material.Water)
-- остров-убежище с аэродромом (верх ≈ y 3)
Terrain:FillBlock(CFrame.new(4900, -4, 0), Vector3.new(760, 14, 1900), Enum.Material.Sand)
Terrain:FillBlock(CFrame.new(4900, -3, 0), Vector3.new(680, 12, 1800), Enum.Material.Grass)
Terrain:FillBall(Vector3.new(4900, -40, 950), 120, Enum.Material.Sand)
Terrain:FillBall(Vector3.new(4900, -40, -950), 120, Enum.Material.Sand)

---------------------------------------------------------------- ГОРЫ (разные!)
-- Типы: острый пик, хребет из нескольких вершин, столовая гора, вулкан, холмы.
local rng = Random.new(1978)
Terrain:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(105, 110, 118))
Terrain:SetMaterialColor(Enum.Material.Basalt, Color3.fromRGB(70, 66, 64))
Terrain:SetMaterialColor(Enum.Material.Granite, Color3.fromRGB(150, 135, 125))
Terrain:SetMaterialColor(Enum.Material.Sandstone, Color3.fromRGB(226, 202, 58)) -- (рапс; для гор не используем)
local ROCKS = { Enum.Material.Rock, Enum.Material.Slate, Enum.Material.Granite, Enum.Material.Basalt }
local SNOW_LINE = 330

-- острый пик: стопка шаров, сужающихся кверху, со случайным смещением — получается неровная вершина
local function peak(x, z, r, h, rock)
	rock = rock or ROCKS[rng:NextInteger(1, #ROCKS)]
	Terrain:FillBall(Vector3.new(x, -r * 0.55, z), r * 1.05, Enum.Material.Grass)
	local steps = rng:NextInteger(4, 6)
	local ox, oz = 0, 0
	for i = 1, steps do
		local t = i / steps
		local rr = r * (1 - t * rng:NextNumber(0.7, 0.88))
		ox += rng:NextNumber(-1, 1) * r * 0.12
		oz += rng:NextNumber(-1, 1) * r * 0.12
		local cy = -r * 0.55 + h * t
		local mat = (cy + rr * 0.6 > SNOW_LINE) and Enum.Material.Snow or rock
		Terrain:FillBall(Vector3.new(x + ox, cy, z + oz), rr, mat)
	end
	task.wait()
end

-- хребет: цепочка пиков разной высоты вдоль случайного направления
local function ridge(x, z, n, r, hMin, hMax)
	local ang = rng:NextNumber(0, math.pi)
	local dx, dz = math.cos(ang), math.sin(ang)
	local rock = ROCKS[rng:NextInteger(1, #ROCKS)]
	for i = 0, n - 1 do
		local s = (i - (n - 1) / 2) * r * rng:NextNumber(0.9, 1.3)
		local rr = r * rng:NextNumber(0.7, 1.15)
		peak(x + dx * s + rng:NextNumber(-60, 60), z + dz * s + rng:NextNumber(-60, 60), rr, rng:NextNumber(hMin, hMax), rock)
	end
end

-- столовая гора: плоская вершина и крутые красноватые склоны
local function mesa(x, z, r, h)
	Terrain:FillCylinder(CFrame.new(x, h / 2 - 20, z), h + 40, r, Enum.Material.Granite)
	Terrain:FillCylinder(CFrame.new(x + rng:NextNumber(-30, 30), h * 0.25, z + rng:NextNumber(-30, 30)), h * 0.5, r * 1.25, Enum.Material.Granite)
	Terrain:FillCylinder(CFrame.new(x, h + 1, z), 6, r * 0.97, Enum.Material.Grass)
	Terrain:FillBall(Vector3.new(x, -r * 0.8, z), r * 1.6, Enum.Material.Grass)
	task.wait()
end

-- вулкан: тёмный конус, кратер с лавой
local function volcano(x, z, r, h)
	for i = 0, 6 do
		local t = i / 6
		Terrain:FillBall(Vector3.new(x, -r * 0.5 + h * t * 0.95, z), r * (1 - t * 0.8), i < 1 and Enum.Material.Grass or Enum.Material.Basalt)
	end
	local top = -r * 0.5 + h * 0.95 + r * 0.2
	Terrain:FillBall(Vector3.new(x, top + r * 0.12, z), r * 0.22, Enum.Material.Air)
	Terrain:FillBall(Vector3.new(x, top - r * 0.12, z), r * 0.12, Enum.Material.CrackedLava)
	task.wait()
end

-- холмы: пологие и зелёные
local function hills(x, z, n)
	for _ = 1, n do
		local r = rng:NextNumber(90, 200)
		local m = rng:NextNumber() < 0.5 and Enum.Material.Grass or Enum.Material.LeafyGrass
		Terrain:FillBall(Vector3.new(x + rng:NextNumber(-300, 300), -r * rng:NextNumber(0.55, 0.75), z + rng:NextNumber(-300, 300)), r, m)
	end
	task.wait()
end

-- запад: большой альпийский хребет + отдельные пики
for i = 0, 4 do
	ridge(-5300 + rng:NextNumber(-300, 200), -4400 + i * 2200, rng:NextInteger(3, 5), rng:NextNumber(260, 360), 380, 700)
end
for _ = 1, 4 do
	peak(rng:NextNumber(-4700, -4200), rng:NextNumber(-4000, 4000), rng:NextNumber(220, 320), rng:NextNumber(500, 820))
end
-- северо-запад: вулкан
volcano(-3900, 4600, 420, 640)
-- юго-запад: столовые горы
mesa(-3700, -4300, 260, 220)
mesa(-3100, -4900, 190, 170)
mesa(-4300, -3600, 160, 260)
-- север и юг: хребты пониже
ridge(-1500, 5600, 5, 240, 250, 480)
ridge(1200, 5700, 4, 220, 220, 420)
ridge(-1200, -5600, 5, 250, 260, 520)
ridge(1600, -5500, 3, 200, 200, 380)
-- холмы ближе к полям
hills(-3200, 1500, 6)
hills(-3300, -1500, 6)
hills(-2600, 4200, 5)
hills(500, -4600, 5)
hills(-500, 4700, 5)

workspace:SetAttribute("WorldReady", true)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00002546"><Properties><string name="Name">TrafficServer</string><ProtectedString name="Source"><![CDATA[-- FlyCrash: машины на дорогах. Ездят туда-обратно по правой полосе.
-- Самолёт может в них врезаться (и они — повод не садиться на дорогу).

local RunService = game:GetService("RunService")

local CFG = { CARS_PER_ROAD = 3, SPEED_MIN = 28, SPEED_MAX = 45 }
local ROADS = "-260,900,-1300,900;420,0,950,1700;-260,-1400,-900,-1900;420,0,1600,-1500;420,0,2250,450;-260,-600,-2000,-600;420,0,450,2700;-260,-1400,-450,-2900;-260,1400,-2600,1900;420,0,1900,2600;-1300,900,-2600,1900;-900,-1900,-450,-2900;950,1700,1900,2600;1600,-1500,2250,450"

local folder = Instance.new("Folder")
folder.Name = "Traffic"
folder.Parent = workspace

local COLORS = {
	Color3.fromRGB(200, 40, 40), Color3.fromRGB(240, 240, 240), Color3.fromRGB(30, 30, 35),
	Color3.fromRGB(40, 90, 180), Color3.fromRGB(235, 190, 40), Color3.fromRGB(60, 140, 80),
}

local function p(parent, size, cf, color, shape, mat)
	local x = Instance.new("Part")
	x.Anchored = true
	x.CanCollide = true
	x.Size = size
	x.CFrame = cf
	x.Color = color
	x.Material = mat or Enum.Material.SmoothPlastic
	x.TopSurface = Enum.SurfaceType.Smooth
	x.BottomSurface = Enum.SurfaceType.Smooth
	if shape then x.Shape = shape end
	x.Parent = parent
	return x
end

local function makeCar()
	local m = Instance.new("Model")
	m.Name = "Car"
	local van = math.random() < 0.3
	local color = COLORS[math.random(#COLORS)]
	local body = p(m, Vector3.new(5, van and 4 or 2.4, van and 11 or 10), CFrame.new(0, van and 3 or 2, 0), color)
	m.PrimaryPart = body
	if not van then
		p(m, Vector3.new(4.6, 1.8, 5), CFrame.new(0, 4, 0.6), color)
	end
	p(m, Vector3.new(4.4, van and 1.6 or 1.4, 0.2), CFrame.new(0, van and 4.2 or 4, van and -5.5 or -1.95), Color3.fromRGB(60, 90, 120), nil, Enum.Material.Glass)
	for _, o in ipairs({ { 2.4, -3.2 }, { -2.4, -3.2 }, { 2.4, 3.2 }, { -2.4, 3.2 } }) do
		p(m, Vector3.new(0.8, 1.9, 1.9), CFrame.new(o[1], 0.95, o[2]), Color3.fromRGB(25, 25, 28), Enum.PartType.Cylinder)
	end
	return m, body.Position.Y
end

local cars = {}
for entry in string.gmatch(ROADS, "[^;]+") do
	local sx, sz, ex, ez = string.match(entry, "(-?%d+),(-?%d+),(-?%d+),(-?%d+)")
	if sx then
		local a = Vector3.new(tonumber(sx), 0.35, tonumber(sz))
		local b = Vector3.new(tonumber(ex), 0.35, tonumber(ez))
		local len = (b - a).Magnitude
		if len > 100 then
			for _ = 1, CFG.CARS_PER_ROAD do
				local car, h = makeCar()
				car.Parent = folder
				table.insert(cars, {
					m = car, h = h, a = a, b = b, len = len, t = math.random() * len,
					dir = math.random() < 0.5 and 1 or -1,
					speed = math.random(CFG.SPEED_MIN, CFG.SPEED_MAX),
				})
			end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	for _, c in ipairs(cars) do
		if c.m.Parent then
			c.t += c.speed * dt * c.dir
			if c.t > c.len then c.t = c.len c.dir = -1 end
			if c.t < 0 then c.t = 0 c.dir = 1 end
			local fwd = (c.b - c.a).Unit * c.dir
			local right = fwd:Cross(Vector3.yAxis)
			local pos = c.a + (c.b - c.a).Unit * c.t + right * 4.2 + Vector3.new(0, c.h, 0)
			c.m:PivotTo(CFrame.lookAt(pos, pos + fwd))
		end
	end
end)
]]></ProtectedString></Properties></Item></Item>
<Item class="StarterPlayer" referent="RBX0000254A"><Properties><string name="Name">StarterPlayer</string><float name="CharacterWalkSpeed">26</float><float name="CharacterJumpPower">55</float></Properties><Item class="StarterPlayerScripts" referent="RBX00002549"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00002548"><Properties><string name="Name">FlyCrashClient</string><ProtectedString name="Source"><![CDATA[-- FlyCrash: клиент — ангар-витрина, приборы, подсказки, пульт хаоса, управление
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local Net = ReplicatedStorage:WaitForChild("FlyCrash")
local ChaosEvent = Net:WaitForChild("Chaos")
local InputEvent = Net:WaitForChild("PilotInput")
local HangarEvent = Net:WaitForChild("Hangar")
local Shared = require(ReplicatedStorage:WaitForChild("FlyCrashShared"))
local hangarRS = ReplicatedStorage:WaitForChild("FlyCrashHangar")
local flightsFolder = workspace:WaitForChild("Flights")

local C = {
	bg = Color3.fromRGB(13, 19, 27),
	panel = Color3.fromRGB(24, 31, 41),
	line = Color3.fromRGB(55, 70, 86),
	text = Color3.fromRGB(236, 240, 245),
	dim = Color3.fromRGB(140, 152, 166),
	accent = Color3.fromRGB(238, 104, 64),
	green = Color3.fromRGB(110, 220, 150),
	blue = Color3.fromRGB(110, 190, 230),
	red = Color3.fromRGB(255, 80, 70),
	yellow = Color3.fromRGB(255, 210, 80),
	white = Color3.new(1, 1, 1),
}

local function make(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end
local function corner(o, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o)
end
local function stroke(o, color, th)
	make("UIStroke", { Color = color or C.line, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function label(parent, props)
	local base = {
		BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 14,
		TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props) do base[k] = v end
	return make("TextLabel", base, parent)
end

local gui = make("ScreenGui", {
	Name = "FlyCrashUI", ResetOnSpawn = false, IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

local flightUI = make("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1 }, gui)
local hangarUI = make("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false }, gui)

local function toast(text)
	local t = label(gui, {
		Size = UDim2.new(0, 420, 0, 44), Position = UDim2.new(0.5, -210, 0, 120),
		BackgroundColor3 = C.bg, BackgroundTransparency = 0.05, Font = Enum.Font.GothamBold,
		TextSize = 17, TextXAlignment = Enum.TextXAlignment.Center, Text = text, ZIndex = 50,
	})
	corner(t, 8)
	stroke(t, C.yellow, 2)
	task.delay(2.5, function() t:Destroy() end)
end

local function money()
	local ls = player:FindFirstChild("leaderstats")
	local m = ls and ls:FindFirstChild("Деньги")
	return m and m.Value or 0
end

local function owned(name)
	for _, n in ipairs(string.split(player:GetAttribute("Owned") or "", "|")) do
		if n == name then return true end
	end
	return false
end

---------------------------------------------------------------- ПРИБОРЫ
local hud = make("Frame", {
	BackgroundTransparency = 1, Size = UDim2.new(0, 780, 0, 56), Position = UDim2.new(0.5, -390, 0, 44),
}, flightUI)
make("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
	HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
}, hud)
local statOrder = 0
local function stat(title, width)
	statOrder += 1
	local f = make("Frame", {
		Size = UDim2.new(0, width, 1, 0), BackgroundColor3 = C.bg, BackgroundTransparency = 0.15,
		BorderSizePixel = 0, LayoutOrder = statOrder,
	}, hud)
	corner(f)
	label(f, { Position = UDim2.new(0, 10, 0, 4), Size = UDim2.new(1, -14, 0, 14), TextSize = 11, TextColor3 = C.dim, Text = title })
	return label(f, { Position = UDim2.new(0, 10, 0, 20), Size = UDim2.new(1, -14, 0, 30), Font = Enum.Font.GothamBold, TextSize = 20, Text = "0" })
end
local speedL = stat("СКОРОСТЬ", 110)
local altL = stat("ВЫСОТА", 95)
local thrL = stat("ГАЗ", 75)
local pitchL = stat("ТАНГАЖ", 80)
local vsL = stat("ВЕРТ. СКОРОСТЬ", 115)
local gearL = stat("ШАССИ", 110)
local stateL = stat("СОСТОЯНИЕ", 150)
hud.Visible = false

-- задание и пассажиры
local mission = make("Frame", {
	Size = UDim2.new(0, 300, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(1, -310, 0, 92),
	BackgroundColor3 = C.bg, BackgroundTransparency = 0.12, BorderSizePixel = 0, Visible = false,
}, flightUI)
corner(mission, 8)
make("UIStroke", { Color = C.green, Thickness = 2 }, mission)
make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10) }, mission)
make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, mission)
label(mission, { Size = UDim2.new(1, 0, 0, 14), TextSize = 11, Font = Enum.Font.GothamBold, TextColor3 = C.green, Text = "ЭВАКУАЦИЯ", LayoutOrder = 1 })
local paxL = label(mission, { Size = UDim2.new(1, 0, 0, 30), TextSize = 26, Font = Enum.Font.GothamBlack, Text = "0 / 0", LayoutOrder = 2 })
local goalL = label(mission, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 14, TextWrapped = true, Font = Enum.Font.GothamMedium, LayoutOrder = 3 })
local distL = label(mission, { Size = UDim2.new(1, 0, 0, 16), TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = C.yellow, LayoutOrder = 4 })

-- указатель цели: с пассажирами — к УБЕЖИЩУ, без пассажиров — к ПАССАЖИРАМ в аэропорт
task.spawn(function()
	local safe, home
	local t0 = os.clock()
	repeat
		safe = workspace:FindFirstChild("SafeZone", true)
		home = workspace:FindFirstChild("PassengerZone", true)
		if not (safe and home) then task.wait(0.5) end
	until (safe and home) or os.clock() - t0 > 30
	if not (safe and home) then return end

	local bb = make("BillboardGui", {
		Adornee = safe, Size = UDim2.new(0, 240, 0, 54), AlwaysOnTop = true, MaxDistance = 100000,
		StudsOffsetWorldSpace = Vector3.new(0, 60, 0), Name = "TargetMarker",
	}, gui)
	local t = label(bb, {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.15, Font = Enum.Font.GothamBlack, TextSize = 18,
		TextColor3 = C.white, TextXAlignment = Enum.TextXAlignment.Center, Text = "",
	})
	corner(t, 8)
	local tStroke = make("UIStroke", { Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, t)

	-- стрелка у края экрана, когда цель не видна
	local arrow = make("Frame", { Size = UDim2.fromOffset(70, 70), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false }, gui)
	local arrowTxt = label(arrow, {
		Size = UDim2.new(1, 0, 1, 0), Font = Enum.Font.GothamBlack, TextSize = 64, Text = ">",
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 3 }, arrowTxt)
	local arrowDist = label(gui, {
		Size = UDim2.fromOffset(160, 22), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false,
		Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center,
	})
	make("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, arrowDist)

	local SAFE_COL = Color3.fromRGB(70, 220, 120)
	local HOME_COL = Color3.fromRGB(255, 150, 50)

	RunService.RenderStepped:Connect(function()
		local hide = hangarUI.Visible
		local own = flightsFolder:FindFirstChild(player.Name)
		local pax = own and own:GetAttribute("Passengers") or 0
		local toSafe = pax > 0
		local target = toSafe and safe or home
		local col = toSafe and SAFE_COL or HOME_COL
		local name = toSafe and "УБЕЖИЩЕ" or "ПАССАЖИРЫ"
		local km = (camera.CFrame.Position - target.Position).Magnitude * Shared.REAL_M / 1000 * 3

		bb.Adornee = target
		bb.Enabled = not hide
		t.Text = ("%s  %.1f км"):format(name, km)
		t.BackgroundColor3 = toSafe and Color3.fromRGB(20, 70, 40) or Color3.fromRGB(90, 45, 10)
		tStroke.Color = col

		-- стрелка: показываем, если цель за краем экрана или позади
		local vp = camera.ViewportSize
		local p = camera:WorldToViewportPoint(target.Position + Vector3.new(0, 60, 0))
		local margin = 90
		local visible = p.Z > 0 and p.X > margin and p.X < vp.X - margin and p.Y > margin and p.Y < vp.Y - margin
		if hide or visible or not own then
			arrow.Visible = false
			arrowDist.Visible = false
			return
		end
		local cx, cy = vp.X / 2, vp.Y / 2
		local dx, dy = p.X - cx, p.Y - cy
		if p.Z < 0 then dx, dy = -dx, -dy end
		if math.abs(dx) < 1 and math.abs(dy) < 1 then dy = -1 end
		local k = math.min((cx - margin) / math.max(math.abs(dx), 1), (cy - margin) / math.max(math.abs(dy), 1))
		local ax, ay = cx + dx * k, cy + dy * k
		arrow.Position = UDim2.fromOffset(ax, ay)
		arrow.Rotation = math.deg(math.atan2(dy, dx))
		arrowTxt.TextColor3 = col
		arrow.Visible = true
		arrowDist.Position = UDim2.fromOffset(ax - dx * k * 0.12, ay - dy * k * 0.12 + 40)
		arrowDist.Text = ("%s %.1f км"):format(name, km)
		arrowDist.TextColor3 = col
		arrowDist.Visible = true
	end)
end)

-- кошелёк в полёте
local GOLD = Color3.fromRGB(255, 200, 50)
local wallet = label(flightUI, {
